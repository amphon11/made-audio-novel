# คัดลอกเป็น .env แล้วแก้ค่าได้ตามต้องการ

# เสียงเริ่มต้น: th-TH-PremwadeeNeural (หญิง) หรือ th-TH-NiwatNeural (ชาย)
TTS_VOICE=th-TH-PremwadeeNeural

# ตัวแปลอังกฤษ→ไทย: auto | hplt | claude | gemini | google
#   auto = claude → gemini → hplt → google ตาม key/โมเดลที่มี
TRANSLATOR=auto

# โมเดล HPLT (สร้างด้วย python scripts/prepare_hplt.py)
# HPLT_MODEL_DIR=models/hplt-en-th

# Claude API (แปลนิยายได้ลื่นที่สุด ไม่บังคับ)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Gemini API (ไม่บังคับ)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# เว้นช่วง request เพื่อไม่ชนโควตา Free Tier (วินาที)
# GEMINI_MIN_INTERVAL=5

# OCR สำหรับ PDF สแกน (ต้องติดตั้ง Tesseract + ภาษา tha, eng)
OCR_LANGUAGES=tha+eng

# Cloudinary เก็บไฟล์ MP3 ถาวร (ไม่บังคับ) รูปแบบ cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=
# CLOUDINARY_FOLDER=made-audio-novel

# ขีดจำกัด
MAX_UPLOAD_MB=20
MAX_PAGES=50
MAX_CHARS=300000

# พอร์ตตอนรันด้วย Docker / Procfile
PORT=8000
